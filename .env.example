# Copy to .env and adjust. Every setting can also be given as an environment variable.
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO

# SQLite by default; for Postgres install the 'postgres' extra and use e.g.
# APP_DATABASE_URL=postgresql+asyncpg://starter:starter@localhost:5432/starter
APP_DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Comma separated or a JSON list.
APP_CORS_ORIGINS=http://localhost:5173

APP_UPLOAD_DIR=data/uploads
APP_MAX_UPLOAD_BYTES=10485760
# APP_ALLOWED_UPLOAD_TYPES=application/pdf,text/csv

APP_MESSAGE_LOG=data/messages.log

# Empty: jobs run in-process. Set a Redis URL (and install the 'redis' extra) to use a
# separate `fastapi-starter worker`.
APP_BROKER_URL=

APP_EXTERNAL_API_URL=https://jsonplaceholder.typicode.com
